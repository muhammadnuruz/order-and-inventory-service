
PROJECT_NAME=Blog + Users API
VERSION=0.1.0
ENVIRONMENT=local                       # local | staging | production
DEBUG=false
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

CORS_ORIGINS=*                          # Comma-separated list, e.g. https://a.com,https://b.com
ALLOWED_HOSTS=*                         # Comma-separated list of allowed Host headers.
RATE_LIMIT=100/minute                   # Applied to /auth/login and /auth/register.
RUN_SCHEDULER=false                     # Leave false: the Celery `beat` service owns periodic scheduling.

# App uses the ASYNC driver (asyncpg). Format: postgresql+asyncpg://user:pass@host:port/db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/db_name
# Alembic uses the SYNC driver (psycopg). Same DB, different driver — see alembic/env.py.
SYNC_DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/db_name

REDIS_URL=redis://redis:6379/0

JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# We use separate Redis logical DBs (1 and 2) to keep them isolated from the cache (DB 0).
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
