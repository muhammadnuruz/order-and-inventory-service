# Version control & IDE
.git
.gitignore
.idea
.vscode

# Python bytecode & caches
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
.venv/
venv/
env/

# Test / type / lint caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Secrets & local env (never bake into the image)
.env
*.env
!.env.example

# Docker / compose files aren't needed inside the image
docker-compose.yaml
Dockerfile
.dockerignore
